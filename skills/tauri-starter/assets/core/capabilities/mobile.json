{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissions of the main window on Android and iOS",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://tauri.app" }, { "url": "https://tauri.app/*" }] }
  ]
}
